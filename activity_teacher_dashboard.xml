<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".TeacherFiles.TeacherDashboard">

    <!-- 🔹 Custom Toolbar -->
    <include layout="@layout/toolbar_dashboard" />

    <!-- 🔹 RecyclerView for Students -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_students_dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        tools:listitem="@layout/item_attendance" />

    <!-- 🔹 Action Buttons Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnMarkAttendance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark Attendance"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFF" />

        <Button
            android:id="@+id/btnAssignHomework"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assign Homework"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#03A9F4"
            android:textColor="#FFF" />

        <Button
            android:id="@+id/btnUploadAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Assignment"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFF" />

        <Button
            android:id="@+id/btn_open_messages"
            android:text="Open Messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


        <Button
            android:id="@+id/btnSendAnnouncement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Announcement"
            android:backgroundTint="#FF5722"
            android:textColor="#FFF" />
    </LinearLayout>

</LinearLayout>
